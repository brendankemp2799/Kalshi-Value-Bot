# ── API Keys ──────────────────────────────────────────────────────────────────
ODDS_API_KEY=
KALSHI_API_KEY=
KALSHI_API_EMAIL=
KALSHI_PRIVATE_KEY_PATH=/home/ubuntu/.kalshi/private_key.pem

# ── Bankroll ──────────────────────────────────────────────────────────────────
BANKROLL=200

# ── Risk ──────────────────────────────────────────────────────────────────────
MIN_EDGE=0.02

# ── Notifications (Pushover — https://pushover.net) ───────────────────────────
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Leave empty for local dev (no auth). Set a strong password for server.
DASHBOARD_PASSWORD=
